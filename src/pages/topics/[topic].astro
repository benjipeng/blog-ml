---
import Base from "../../layouts/Base.astro";
import Moved from "../../components/Moved.astro";
import {
  articleDescription,
  articlePath,
  articleTopics,
  formatDate,
  getTopicBuckets,
  readingTime,
  topicLabel,
  MIN_TOPIC_ARTICLES,
} from "../../lib/content";
import { articleItemList, collectionPage } from "../../lib/schema";

// Every topic still answers at its URL. Only the ones at or above the threshold
// get a page of their own: a page built from a single article restates that
// article and nothing more, which is a thin page in the index and a dead end
// for a reader.
//
// The rest forward to the one piece they name, which is everything such a page
// would have shown anyway. They are not dropped, because these URLs are already
// in the index and a 404 discards whatever standing they had.
export async function getStaticPaths() {
  const buckets = await getTopicBuckets();
  return buckets.map(({ slug, name, entries }) => ({
    params: { topic: slug },
    props: {
      slug,
      name,
      entries,
      indexed: entries.length >= MIN_TOPIC_ARTICLES,
    },
  }));
}

const { slug, name, entries, indexed } = Astro.props;
// Topics are stored lowercase-hyphenated, so the title, the meta, and the H1
// all read "machine learning" rather than "machine-learning".
const label = topicLabel(name);
const count = entries.length;
const description = `Every RenoCrypt piece on ${label}, ${count} in all. Long-form technical writing on machine learning, AI, and engineering.`;

const collectionSchema = collectionPage({
  name: `${label} · Topics`,
  path: `/topics/${slug}/`,
  description,
  mainEntity: articleItemList(entries),
});
---

{
  indexed ? (
    <Base
      title={`${label} · Topics · RenoCrypt`}
      description={description}
      jsonLd={collectionSchema}
      breadcrumbs={[
        { name: "Topics", href: "/topics/" },
        { name: label, href: `/topics/${slug}/` },
      ]}
    >
      <section class="mx-auto max-w-6xl px-5 py-12 sm:px-8 lg:py-16">
        <header class="max-w-3xl">
          <a href="/topics/" class="eyebrow transition-colors hover:text-accent">
            &rsaquo;&nbsp;&nbsp;topics
          </a>
          <h1 class="mt-5 font-display text-[2.2rem] leading-tight sm:text-5xl">
            {label}
          </h1>
          <p class="mt-5 font-mono text-sm uppercase tracking-[0.14em] text-muted">
            {count} {count === 1 ? "piece" : "pieces"}
          </p>
        </header>

        <div class="mt-10">
          {entries.map((entry) => (
            <a class="article-card" href={articlePath(entry)}>
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-muted">
                <span>{formatDate(entry.data.date)}</span>
                <span>{readingTime(entry)} min read</span>
              </div>
              <h2 class="mt-3 max-w-3xl font-display text-2xl">
                {entry.data.title}
              </h2>
              <p class="mt-2 max-w-2xl leading-relaxed text-muted">
                {articleDescription(entry)}
              </p>
              <div class="mt-4 flex flex-wrap gap-2">
                {articleTopics(entry)
                  .slice(0, 4)
                  .map((t) => (
                    <span class="reno-chip">{t}</span>
                  ))}
              </div>
            </a>
          ))}
        </div>
      </section>
    </Base>
  ) : (
    <Moved to={articlePath(entries[0])} />
  )
}
