---
import Base from "../../layouts/Base.astro";
import { getIndexedTopics, topicLabel } from "../../lib/content";
import { collectionPage, linkItemList } from "../../lib/schema";
import Constellation from "../../components/art/Constellation.astro";

// Only the topics that have a page, so the index never points at a page that
// was not built.
const topics = await getIndexedTopics();

// Three quiet size tiers, so frequency reads as hierarchy, not noise.
const tier = (count: number) =>
  count >= 5
    ? "text-[2rem] text-fg sm:text-[2.7rem]"
    : count >= 3
      ? "text-2xl text-fg sm:text-[1.7rem]"
      : "text-lg text-muted";

const collectionSchema = collectionPage({
  name: "Topics",
  path: "/topics/",
  mainEntity: linkItemList(
    topics.map((topic) => ({
      name: topicLabel(topic.name),
      path: `/topics/${topic.slug}/`,
    }))
  ),
});
---

<Base
  title="Topics · RenoCrypt"
  description="The recurring threads across RenoCrypt writing on machine learning, AI, and engineering."
  jsonLd={collectionSchema}
  breadcrumbs={[{ name: "Topics", href: "/topics/" }]}
>
  <section class="mx-auto max-w-5xl px-5 py-12 sm:px-8 lg:py-16">
    <div class="grid items-center gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:gap-12">
      <header class="max-w-3xl">
        <p class="eyebrow">&rsaquo;&nbsp;&nbsp;index</p>
        <h1 class="mt-5 font-display text-[2.2rem] leading-tight sm:text-5xl">
          Topics
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">
          The threads the writing keeps returning to. A topic earns a place here
          once a second piece joins it, and the ones written about most often
          show largest.
        </p>
      </header>
      <div class="mx-auto w-full max-w-[380px]">
        <Constellation />
      </div>
    </div>

    <nav class="mt-12 flex flex-wrap items-baseline gap-x-7 gap-y-4">
      {
        topics.map((topic) => (
          <a
            href={`/topics/${topic.slug}/`}
            class={`group font-display leading-none tracking-[-0.02em] transition-colors hover:text-accent ${tier(topic.entries.length)}`}
            style="font-weight:500"
          >
            {topicLabel(topic.name)}
            <sup class="ml-0.5 align-super font-mono text-[0.55em] font-normal text-muted transition-colors group-hover:text-accent">
              {topic.entries.length}
            </sup>
          </a>
        ))
      }
    </nav>
  </section>
</Base>
