---
import {
  articlePath,
  getTopicBuckets,
  MIN_TOPIC_ARTICLES,
} from "../../lib/content";
import Moved from "../../components/Moved.astro";

// The site used to publish taxonomy pages under /tags/. Those URLs are still
// in the index and now return 404, which discards whatever standing they had.
// Send each one to its /topics/ counterpart instead.
//
// Paths come from the same content the topic pages are built from, so this
// stays in step with the taxonomy on its own. Only slugs that changed shape in
// the move need naming, and each is listed because it was seen in the index —
// not guessed.
//
// getStaticPaths runs in its own scope, so everything it needs lives inside it.
export async function getStaticPaths() {
  const RENAMED: Record<string, string> = {
    "large-language-model": "large-language-models",
  };

  // Where a topic leads now: its own page when it has one, otherwise the single
  // piece it names. Resolving it here means an old tag URL forwards straight to
  // a destination rather than to another forward.
  const buckets = await getTopicBuckets();
  const destinations = new Map(
    buckets.map((bucket) => [
      bucket.slug,
      bucket.entries.length >= MIN_TOPIC_ARTICLES
        ? `/topics/${bucket.slug}/`
        : articlePath(bucket.entries[0]),
    ])
  );

  const paths = [...destinations].map(([slug, to]) => ({
    params: { tag: slug },
    props: { to },
  }));

  for (const [from, to] of Object.entries(RENAMED)) {
    const destination = destinations.get(to);
    if (destination && !destinations.has(from)) {
      paths.push({ params: { tag: from }, props: { to: destination } });
    }
  }

  return paths;
}

const { to } = Astro.props;
---

<Moved to={to} />
