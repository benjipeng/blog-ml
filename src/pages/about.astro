---
import Base from "../layouts/Base.astro";
import Aurora from "../components/art/Aurora.astro";
import { SITE, AUTHOR, absolute } from "../lib/site";

// The page that says who is behind the writing, declared as such. It is the
// node the articles' author field resolves to.
const profileSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  url: absolute("/about/"),
  inLanguage: SITE.language,
  isPartOf: { "@id": `${SITE.url}/#website` },
  mainEntity: {
    "@type": "Person",
    name: AUTHOR.name,
    url: AUTHOR.url,
    description:
      "Writes RenoCrypt. Background in physical chemistry and data science, which shapes a bias toward first principles, mathematical structure, and practical implementation.",
    knowsAbout: [
      "Machine learning",
      "Large language models",
      "AI systems engineering",
      "Security research",
    ],
    worksFor: { "@id": `${SITE.url}/#organization` },
  },
};
---

<Base
  title="About · RenoCrypt"
  description="About RenoCrypt, Matrix Alchemy: technical writing on machine learning, AI, and engineering."
  jsonLd={profileSchema}
  breadcrumbs={[{ name: "About", href: "/about/" }]}
>
  <section class="mx-auto max-w-6xl px-5 py-12 sm:px-8 lg:py-16">
    <div class="grid items-center gap-8 lg:grid-cols-[1fr_0.8fr] lg:gap-12">
      <div class="max-w-3xl">
        <p class="eyebrow">&rsaquo;&nbsp;&nbsp;about</p>
        <h1 class="mt-5 font-display text-[2.2rem] leading-tight sm:text-5xl">
          RenoCrypt is Matrix Alchemy.
        </h1>
      </div>
      <div class="mx-auto w-full max-w-[360px]">
        <Aurora />
      </div>
    </div>
    <div class="max-w-3xl">
      <div class="article-body mt-10">
        <p>
          RenoCrypt publishes technical writing on machine learning, AI, and
          engineering: the math underneath models, the systems that make them
          useful, and the craft of turning experiments into shipped tools.
        </p>
        <p>
          Written by Benji, whose background in physical chemistry and data
          science shapes the writing's bias toward first principles,
          mathematical structure, and practical implementation.
        </p>
        <p>
          It favors clean typography and fast pages, with math and code treated
          as first-class, so the long-form notes stay readable and exact.
        </p>
      </div>

      <div class="mt-8 flex flex-wrap gap-2">
        <a class="reno-chip" href="https://github.com/renocrypt">GitHub</a>
        <a class="reno-chip" href="https://github.com/benjipeng/renocrypt.com">Source</a>
        <a class="reno-chip" href="/rss.xml">RSS</a>
      </div>
    </div>
  </section>
</Base>
